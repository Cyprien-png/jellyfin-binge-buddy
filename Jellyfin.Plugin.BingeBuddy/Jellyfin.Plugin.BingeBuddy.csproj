<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.BingeBuddy</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\js\plugin.js" />
    <EmbeddedResource Include="Web\js\utils\assetUrl.js" />
    <EmbeddedResource Include="Web\js\utils\jellyfinHooks.js" />
    <EmbeddedResource Include="Web\js\components\navbar\navbar.js" />
    <EmbeddedResource Include="Web\js\components\navbar\navbar.css" />
    <EmbeddedResource Include="Web\js\components\dialog\dialog.js" />
    <EmbeddedResource Include="Web\js\components\dialog\dialog.css" />
    <EmbeddedResource Include="Web\js\components\watchTogether\watchTogetherDialog.js" />
    <EmbeddedResource Include="Web\js\components\watchTogether\watchTogetherDialog.css" />
    <EmbeddedResource Include="Web\js\components\userSelect\userSelect.js" />
    <EmbeddedResource Include="Web\js\components\userSelect\userSelect.css" />
    <EmbeddedResource Include="Web\js\components\mediaSelect\mediaSelect.js" />
    <EmbeddedResource Include="Web\js\components\mediaSelect\mediaSelect.css" />
    <EmbeddedResource Include="Web\js\components\watchProgress\watchProgress.js" />
    <EmbeddedResource Include="Web\js\components\watchProgress\watchProgress.css" />
    <EmbeddedResource Include="Web\js\components\watchTogetherPending\watchTogetherPendingDialog.js" />
    <EmbeddedResource Include="Web\js\components\watchTogetherPending\watchTogetherPendingDialog.css" />
    <EmbeddedResource Include="Web\js\components\overlays\overlays.js" />
    <EmbeddedResource Include="Web\js\components\overlays\overlays.css" />
    <EmbeddedResource Include="Web\js\services\watchTogetherSession.js" />
    <EmbeddedResource Include="Web\js\services\watchTogetherContext.js" />
    <EmbeddedResource Include="Web\js\services\watchTogetherHistoryService.js" />
    <EmbeddedResource Include="Web\js\services\watchTogetherQueueService.js" />
    <EmbeddedResource Include="Web\js\services\playbackGateService.js" />
    <EmbeddedResource Include="Web\js\services\playbackStopService.js" />
  </ItemGroup>

</Project>
